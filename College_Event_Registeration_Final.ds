		workflow
		{
		form
		{
			registeration_confirmatio as "registeration_confirmation"
			{
				type =  form
				form = Team_Registration

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											/*
										  Workflow 1: Registration Confirmation Email
										  Form: Team Registration
										  Trigger: Successful Form Submission (On Success)
										*/
										if(input.Team_Leader_Email != null && input.Team_Leader_Email != "")
										{
											teamName = ifnull(input.Team_Name,"Registered Team");
											leaderName = ifnull(input.Team_Leader_Name,"Team Leader");
											teamCode = ifnull(input.Team_Code,"N/A");
											regStatus = ifnull(input.Registration_Status,"Registered");
											emailSubject = "Registration Confirmation - " + teamName;
											emailMessage = "Dear " + leaderName + ",\n\n" + "Thank you for registering! Your team registration has been recorded successfully.\n\n" + "Registration Details:\n" + "- Team Name: " + teamName + "\n" + "- Team Code: " + teamCode + "\n" + "- Registration Status: " + regStatus + "\n\n" + "Best regards,\n" + "College Event Organizing Committee";
											sendmail
											[
												from :zoho.adminuserid
												to :input.Team_Leader_Email
												subject :emailSubject
												message :emailMessage
											]
										}
						)
					}
				}

			}
			Send_Project_Submission_R as "Send Project Submission Recipt"
			{
				type =  form
				form = Project_Submission

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											/*
										  Workflow 3: Project Submission Receipt
										  Form: Project Submission
										  Trigger: Successful Form Submission (On Success)
										  
										  Uses the 'Team' lookup field present on the form to access
										  team details and send the receipt email.
										*/
										if(input.Team != null)
										{
											subTitle = ifnull(input.Submission_Title,"Project Submission");
											teamName = ifnull(input.Team.Team_Name,"Your Team");
											leaderName = ifnull(input.Team.Team_Leader_Name,"Team Leader");
											leaderEmail = input.Team.Team_Leader_Email;
											if(leaderEmail != null && leaderEmail != "")
											{
												sendmail
												[
													from :zoho.adminuserid
													to :leaderEmail
													subject :"Project Submission Received - " + subTitle
													message :"Dear " + leaderName + ",\n\n" + "Your project submission '" + subTitle + "' has been successfully received for team '" + teamName + "'.\n\n" + "Your project is currently awaiting organizer review.\n\n" + "Best regards,\n" + "College Event Organizing Committee"
												]
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			Deadline_Reaminder as "Deadline Reaminder"
			{
				type =  schedule
				start = "2026-10-30 08:30:23"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						/*
										  Workflow 2: Registration Deadline Reminder
										  Context: Scheduled Workflow (Daily Schedule)
										*/
										// Replace with your verified organizer email
										organizerEmail = "organizer@example.com";
										if(organizerEmail != null && organizerEmail != "" && organizerEmail != "organizer@example.com")
										{
											tomorrowDate = zoho.currentdate.addDay(1);
											deadlineStr = tomorrowDate.toString("yyyy-MM-dd");
											// Fetch open events closing tomorrow
											eventsClosing = Events[Registration_Deadline == tomorrowDate && Event_Status == "Open"];
											for each  eventRec in eventsClosing
											{
												eventName = ifnull(eventRec.Event_Name,"College Event");
												eventCode = ifnull(eventRec.Event_Code,"N/A");
												venue = ifnull(eventRec.Event_Venue,"Campus");
												sendmail
												[
													from :zoho.adminuserid
													to :organizerEmail
													subject :"REMINDER: Registration Closes Tomorrow - " + eventName
													message :"Hello Organizer,\n\n" + "This is a reminder that registration for the following event closes tomorrow (" + deadlineStr + "):\n\n" + "- Event Name: " + eventName + "\n" + "- Event Code: " + eventCode + "\n" + "- Venue: " + venue + "\n\n" + "Best regards,\n" + "College Event Registration System"
												]
											}
										}
					)
					}
				}
			}
		}




	}
