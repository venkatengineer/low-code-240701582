 application "College Event Registeration Final"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Events
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Event_Name
			(
    			type = text
				displayname = "Event Name"
				initial value = "College Innovation Hackathon"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Code
			(
    			type = text
				displayname = "Event Code"
				initial value = "CIH2026"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Description
			(
    			type = text
				displayname = "Event Description"
				initial value = "Sample event for testing"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Start_Date
			(
    			type = date
				displayname = "Event Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_End_Date
			(
    			type = date
				displayname = "Event End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Registration_Deadline
			(
    			type = date
				displayname = "Registration Deadline"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Venue
			(
    			type = text
				displayname = "Event Venue"
				initial value = "College Campus"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Event_Status
			(
    			type = text
				displayname = "Event Status"
				initial value = "Draft"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Phase_1_Fee
			(
				type = number
				displayname = "Phase 1 Fee"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Phase_2_Fee_Per_Participant
			(
				type = number
				displayname = "Phase 2 Fee Per Participant"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Maximum_Team_Size
			(
				type = number
				displayname = "Maximum Team Size"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Project_Submission
		{
			displayname = "Project Submission"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Submission_Title
			(
    			type = text
				displayname = "Submission Title"
				initial value = "Smart Campus Assistant"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Team
			(
				type = picklist	
				values  = Team_Registration.ID
    			displayformat = [Team_Code]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Problem_Statement
			(
    			type = text
				displayname = "Problem Statement"
				initial value = "Students need a better way to discover campus services."
	 			row = 1
	 			column = 1   
				width = medium
			)
			Proposed_Solution
			(
    			type = text
				displayname = "Proposed Solution"
				initial value = "An AI-powered assistant that answers campus-related questions."
	 			row = 1
	 			column = 1   
				width = medium
			)
			Technology_Stack
			(
    			type = text
				displayname = "Technology Stack"
				initial value = "Python, React, REST API"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Project_Abstract
			(
    			type = text
				displayname = "Project Abstract"
				initial value = "A proposed intelligent campus assistant that helps students find information about events, facilitie"
	 			row = 1
	 			column = 1   
				width = medium
			)
			AI_Evaluation_Status
			(
    			type = text
				displayname = "AI Evaluation Status"
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
			AI_Evaluation_Score
			(
				type = number
				displayname = "AI Evaluation Score"
	 			row = 1
	 			column = 1   
				width = medium
			)
			AI_Evaluation_Summary
			(
    			type = text
				displayname = "AI Evaluation Summary"
				initial value = "Not evaluated"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Organizer_Decision
			(
    			type = text
				displayname = "Organizer Decision"
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Keyword
			(
    			type = textarea
				displayname = "Project Keyword"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = KeywordExtractor
									basefield = Project_Abstract
						)
			)
			Proposal_Image
			(
    			type = image
				displayname = "Proposal Image"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			OCR
			(
    			type = textarea
				displayname = "Extracted Proposal Text"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = OCR
									basefield = Proposal_Image
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
